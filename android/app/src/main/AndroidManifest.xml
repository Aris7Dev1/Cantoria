<?xml version="1.0" encoding="utf-8"?>
<!-- Coquille WebView Cantoria (décision PR #33).
     Permission INTERNET : l'unique exception réseau de VISION.md (« le
     processus principal interroge GitHub Releases pour la mise à jour
     automatique, et uniquement cela ») s'applique à la coquille Android —
     équivalent du main.js desktop. Elle sert EXCLUSIVEMENT au UpdateChecker
     (issue #57) : la WebView reste à zéro appel réseau. Le stockage privé
     (filesDir) et le Storage Access Framework n'exigent aucune permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Permission REQUEST_INSTALL_PACKAGES : installation de la mise à jour
         sideload (issue #57, volet installation). L'app télécharge l'APK plus
         récent depuis GitHub Releases (unique exception réseau de VISION.md)
         puis lance l'installateur SYSTÈME — l'utilisateur garde le geste final
         de confirmation, aucune installation silencieuse. Le refus de la
         permission n'empêche ni le téléchargement ni l'usage de l'app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="Cantoria"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Cantoria"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Partage de l'APK téléchargé (stockage privé filesDir/updates) avec
             l'installateur système : FileProvider, accès en lecture limité à
             l'URI de l'intent (issue #57). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
