<?xml version="1.0" encoding="utf-8"?>
<!-- Coquille WebView Cantoria (décision PR #33).
     Permission INTERNET : l'unique exception réseau de VISION.md (« le
     processus principal interroge GitHub Releases pour la mise à jour
     automatique, et uniquement cela ») s'applique à la coquille Android —
     équivalent du main.js desktop. Elle sert EXCLUSIVEMENT au UpdateChecker
     (issue #57) : la WebView reste à zéro appel réseau. Le stockage privé
     (filesDir) et le Storage Access Framework n'exigent aucune permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Cantoria"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Cantoria"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
