#!/usr/bin/env bash
# Wrapper minimal : télécharge gradle-wrapper si absent, puis lance Gradle.
# (Android Studio génère le wrapper complet à la première ouverture du projet.)
set -euo pipefail
cd "$(dirname "$0")"
if [ ! -f gradle/wrapper/gradle-wrapper.jar ] && command -v gradle >/dev/null 2>&1; then
  gradle wrapper --gradle-version 8.7 >/dev/null
fi
if command -v gradle >/dev/null 2>&1; then
  exec gradle "$@"
fi
echo "Erreur : gradle (ou Android Studio) requis pour builder le projet Android." >&2
exit 1
